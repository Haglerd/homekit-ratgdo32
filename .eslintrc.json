{
  "env": { "browser": true, "es2021": true },
  "parserOptions": { "ecmaVersion": 2021 },
  "globals": {
    "loaderElem": "readonly",
    "newPW": "readonly",
    "confirmPW": "readonly",
    "QRCode": "readonly",
    "marked": "readonly"
  },
  "rules": {
    "no-duplicate-case": "error",
    "no-unreachable": "error",
    "no-undef": "error",
    "no-unused-vars": "warn",
    "eqeqeq": "warn",
    "no-fallthrough": "error"
  }
}
