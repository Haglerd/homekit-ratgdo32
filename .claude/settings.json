{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(pio *)",
      "Bash(platformio *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(ssh dakot@100.121.96.114 *)",
      "Bash(ls /c/Users/Dakot/.platformio/*)",
      "Bash(ls C:/Users/Dakot/.platformio/*)",
      "Bash(curl -s http://10.112.60.151/*)",
      "Bash(curl -s --max-time * http://10.112.60.151/*)",
      "Bash(/c/Users/Dakot/AppData/Roaming/Python/Python310/Scripts/pio.exe *)",
      "Bash(/c/Users/Dakot/AppData/Roaming/Python/Python310/Scripts/platformio.exe *)",
      "Bash(C:/Users/Dakot/AppData/Roaming/Python/Python310/Scripts/pio.exe *)",
      "Bash(C:/Users/Dakot/AppData/Roaming/Python/Python310/Scripts/platformio.exe *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(pwsh *)",
      "Bash(pwsh.exe *)",
      "Bash(powershell *)",
      "Bash(powershell.exe *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-fork-check.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-no-ai-attribution.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-branch-guard.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-heap-warn.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
